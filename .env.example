# Required: Jetson device connection
JETSON_HOST=192.168.1.100
JETSON_USER=jetson
JETSON_IP=192.168.1.100

# Required: Password for sudo operations
JETSON_PASSWORD=your_password

# Authentication method
USE_SSH_KEY_AUTH=true
SSH_PRIVATE_KEY_PATH=id_rsa
SSH_PUBLIC_KEY_PATH=id_rsa.pub

# For password authentication, set USE_SSH_KEY_AUTH=false
# (JETSON_PASSWORD above will be used for both login and sudo)

# Optional: WiFi configuration
WIFI_SSID=YourWiFiNetwork
WIFI_PASSWORD=your_wifi_password

# Optional: Device specs
JETSON_ARCH=arm64
JETSON_JETPACK_VERSION=6.2

# --- VPS controller bootstrap (localhost playbook; export before make bootstrap-jenkins) ---
# VPS_VPN_ALLOW_CIDR=10.8.0.0/24
# VPS_CONFIGURE_FIREWALL=true
# VPS_CONTROLLER_REPO_URL=https://github.com/your-org/lucy_jetson_automator.git
# VPS_JENKINS_BIND=127.0.0.1
# VPS_JENKINS_URL=https://jenkins.vpn.example/
# ANSIBLE_BECOME_PASS=   # sudo on VPS if needed (or use ansible-playbook -K)
# VPS_ENABLE_FAIL2BAN=false
# VPS_ENABLE_UNATTENDED_UPGRADES=false