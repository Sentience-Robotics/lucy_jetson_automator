# Root `.env` — **VPS Jenkins bootstrap only** (`make bootstrap-jenkins`, `./bootstrap-vps.sh`).
# Join VPN first; set SSH target and VPS options below.

VPS_SSH_HOST=<vps-ip>
VPS_SSH_USER=ubuntu
VPS_SSH_PORT=22
VPS_SSH_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
VPS_CONFIGURE_FIREWALL=true
VPS_CONTROLLER_REPO_URL=https://github.com/sentience-robotics/lucy_jetson_automator.git
VPS_JENKINS_BIND=<vps-ip>
VPS_JENKINS_URL=http://<vps-ip>/
# GID of the host `docker` group (see `stat -c '%g' /var/run/docker.sock` on the VPS). Used by Jenkins Compose for Docker cloud agents.
VPS_JENKINS_DOCKER_SOCK_GID=988
ANSIBLE_BECOME_PASS=
VPS_ENABLE_FAIL2BAN=false
VPS_ENABLE_UNATTENDED_UPGRADES=false
